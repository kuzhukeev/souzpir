# Прод-шаблон: все секреты пустые, живые каналы выключены. Скопировать в
# shared/.env на хосте, заполнить секреты и реальные адреса, затем chmod 600.
# Список ключей покрывает все env() из config/ — см. docs/release/prod-runbook.md
# и tests/Feature/Launch/L1-08/ProductionEnvExampleTest.php.

APP_NAME="Союз Пир"
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://souzpir.example.com
APP_INSTANCE=souzpir-main
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
# Shared storage path outside the release directory (symlinked by deploy.sh).
APP_STORAGE_PATH=/var/www/souzpir/shared/storage
APP_PREVIEW_DATABASE=souzpir_prod
CABINET_ORGANIZATION_ID=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=
LOG_SLACK_EMOJI=
LOG_PAPERTRAIL_HANDLER=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=souzpir_prod
DB_USERNAME=souzpir_app
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8
DB_COLLATION=utf8mb4_unicode_ci
DB_SSLMODE=prefer
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=
DB_FOREIGN_KEYS=true
DB_TEST_DATABASE=
MYSQL_ATTR_SSL_CA=

DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=
CACHE_STORAGE_DISK=
CACHE_STORAGE_PATH=framework/cache/data

AUTH_GUARD=web
AUTH_MODEL=
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=souzpir_main_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

CACHE_STORE=database
CACHE_PREFIX=souzpir-main:

QUEUE_CONNECTION=database
QUEUE_NAMESPACE=souzpir-main
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
FEATURES_SCHEDULING_ENABLED=true

# Внешние драйверы очереди не используются (QUEUE_CONNECTION=database), но
# ключи присутствуют для полноты списка config/queue.php.
BEANSTALKD_QUEUE=
BEANSTALKD_QUEUE_HOST=
BEANSTALKD_QUEUE_RETRY_AFTER=90
SQS_PREFIX=
SQS_QUEUE=
SQS_SUFFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CLUSTER=redis
REDIS_URL=
REDIS_PERSISTENT=false
REDIS_PREFIX=souzpir-main:
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_QUEUE=
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=

BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS="noreply@souzpir.example.com"
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Все живые/платные драйверы выключены по умолчанию — включать явно на проде
# после проверки (docs/release/prod-runbook.md).
AI_DRIVER=fake
AI_BUDGET_MONTHLY_USD=30
AI_BUDGET_DAILY_USD=3
DELIVERY_DRIVER=fake
NOTIFICATION_DRIVER=fake
VISION_LIVE_MEASUREMENTS_ENABLED=false
VISION_MEASUREMENT_QUEUE_ENABLED=false
VISION_MEASUREMENT_SCHEDULE_ENABLED=false

# Доверенный непосредственный прокси перед приложением: пусто = не доверять
# forwarding-заголовкам (см. docs/runbooks/https-forwarding.md).
TRUSTED_PROXIES=

INERTIA_SSR_ENABLED=false
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=false
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_HOT_URL=
INERTIA_SSR_TIMEOUT=
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
INERTIA_SSR_THROW_ON_ERROR=false
INERTIA_ENCRYPT_HISTORY=true
INERTIA_PRESERVE_BIG_INTEGERS=false
INERTIA_DEVTOOLS_ENABLED=false
INERTIA_DEVTOOLS_GATE=
INERTIA_DEVTOOLS_TTL_HOURS=24
INERTIA_DEVTOOLS_PRUNE_INTERVAL_SECONDS=300
INERTIA_DEVTOOLS_LIMIT=100

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_PORT=5173
