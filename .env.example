APP_NAME="Союз Пир"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://souzpir.local
APP_INSTANCE=souzpir-main
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.1.48
DB_PORT=5432
DB_DATABASE=souzpir_dev
DB_USERNAME=souzpir_app
DB_PASSWORD=
APP_PREVIEW_DATABASE=souzpir_dev
DB_TEST_DATABASE=souzpir_test_main

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=souzpir_main_session
CACHE_STORE=file
CACHE_PREFIX=souzpir-main:
REDIS_PREFIX=souzpir-main:
QUEUE_CONNECTION=sync
QUEUE_NAMESPACE=souzpir-main
FEATURES_SCHEDULING_ENABLED=false
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS=preview@example.test
MAIL_FROM_NAME="${APP_NAME}"
AI_DRIVER=fake
DELIVERY_DRIVER=fake

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_PORT=5173
# Absolute APP_STORAGE_PATH, APP_CONFIG_CACHE, APP_ROUTES_CACHE,
# APP_EVENTS_CACHE and VIEW_COMPILED_PATH can be supplied inside this
# checkout's .local/runtime. Defaults are isolated automatically.
# Tests load .env.testing and require a separate database with _test_ in its name.
