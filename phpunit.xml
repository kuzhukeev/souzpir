<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".local/runtime/testing/phpunit-cache">
    <testsuites>
        <testsuite name="Core">
            <directory suffix="Test.php">tests/Unit</directory>
            <directory suffix="Test.php">tests/Feature/Ai</directory>
            <directory suffix="Test.php">tests/Feature/AiRawBoundary</directory>
            <directory suffix="Test.php">tests/Feature/Database</directory>
            <directory suffix="Test.php">tests/Feature/KnowledgeEquivalence</directory>
            <directory suffix="Test.php">tests/Feature/Preview</directory>
            <directory suffix="Test.php">tests/Feature/Privacy</directory>
            <directory suffix="Test.php">tests/Feature/ProtectedOperations</directory>
            <directory suffix="Test.php">tests/Feature/Runtime</directory>
            <directory suffix="Test.php">tests/Feature/SharedProps</directory>
            <directory suffix="Test.php">tests/Feature/Smoke</directory>
            <directory suffix="Test.php">tests/Feature/Support</directory>
        </testsuite>
        <testsuite name="Shell"><directory suffix="Test.php">tests/Feature/Shell</directory></testsuite>
        <testsuite name="Product">
            <directory suffix="Test.php">tests/Feature/Seller</directory>
            <directory suffix="Test.php">tests/Feature/Tenancy</directory>
            <directory suffix="Test.php">tests/Feature/Vision</directory>
        </testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="CABINET_ORGANIZATION_ID" value="01J00000000000000000000000" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="log"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="AI_DRIVER" value="fake"/>
        <env name="DELIVERY_DRIVER" value="fake"/>
        <env name="FEATURES_SCHEDULING_ENABLED" value="false"/>
        <!-- Integration suites exercise the enabled feature; gating tests override it explicitly. -->
        <env name="PROFILE_SETTINGS_ENABLED" value="true"/>
    </php>
</phpunit>
